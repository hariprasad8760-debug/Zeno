{
  "manifest_version": 3,
  "name": "Zeno AI Assistant",
  "version": "1.0",
  "description": "Your intelligent, minimal code companion floating across the web.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["zeno-web-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/purify.min.js",
        "lib/marked.min.js",
        "lib/highlight.min.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png",
        "brain_logo.png",
        "lib/github-dark.min.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "brain_logo.png",
    "48": "brain_logo.png",
    "128": "brain_logo.png"
  },
  "action": {
    "default_title": "Zeno AI Assistant",
    "default_popup": "popup.html",
    "default_icon": "brain_logo.png"
  }
}
